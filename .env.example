# PostgreSQL: витрина labeled_transactions, состояние окна и таблица scores.
POSTGRES_USER=fraud_user
POSTGRES_PASSWORD=fraud_pass
POSTGRES_DB=fraud_db
# Имя сервиса в docker-compose, изнутри сети контейнеров.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TRANSACTIONS_TOPIC=transactions
KAFKA_SCORING_TOPIC=scores

# Размеченный CSV. Монтируется в data_loader и transaction_simulator.
# Путь должен быть понятен демону Docker:
#   Linux/macOS: /home/user/datasets/train.csv
#   Docker Desktop на Windows: C:/Users/user/datasets/train.csv
#   Docker внутри WSL2: /mnt/c/Users/user/datasets/train.csv
# Укажите свой путь: без него docker compose не сможет смонтировать файл.
TRAIN_DATA_CSV=/path/to/train.csv
